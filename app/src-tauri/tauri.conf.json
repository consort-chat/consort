{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Consort",
  "version": "0.1.5",
  "identifier": "chat.consort.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Consort",
        "width": 1100,
        "height": 720,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: consortmedia: http://consortmedia.localhost; media-src 'self' consortmedia: http://consortmedia.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libsoup-3.0-0",
          "libsqlite3-0"
        ]
      }
    },
    "shortDescription": "Matrix client with voice",
    "longDescription": "Consort is a desktop chat client for the Matrix protocol."
  }
}
